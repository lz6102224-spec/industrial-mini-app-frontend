# ===== 通用配置（所有模式共享）=====
VITE_APP_TITLE=工业 miniApp · 制造数字化管理平台

# ===== xDM-F 运行态配置 =====
# 本地运行态 SDK 部署后的访问地址（业务层 / 前端代理目标）
VITE_XDMF_ENDPOINT=http://127.0.0.1:8080
# 运行态环境 ID（部署 xDM-F 运行态时生成）
VITE_XDMF_ENV_ID=env-01
# 应用英文名（设计态发布的应用 ID），最终 URL 形如 /{envId}/rdm_{appId}_app
VITE_XDMF_APP_ID=IndustrialMiniAPP
# iDME 获取的 X-Auth-Token（有效期 24h，过期需重新获取）
VITE_XDMF_TOKEN=
# 专属云场景需要，公有云留空
VITE_XDMF_PROJECT_ID=

# 请求超时（毫秒）
VITE_REQUEST_TIMEOUT=15000
